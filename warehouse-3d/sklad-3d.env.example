# Настройки сервера «Склад 3D».
# Скопируйте в sklad-3d.env рядом с package.json (служба Linux читает /etc/sklad-3d.env, Docker — .env)
# и поправьте. Ключи командной строки и переменные окружения важнее этого файла.

# 0.0.0.0 — слушать все сетевые интерфейсы: приложение открывается с других компьютеров сети
HOST=0.0.0.0
PORT=8080

# Где хранить общую модель складов и резервные копии (по умолчанию — папка data рядом с приложением)
#DATA_DIR=/var/lib/sklad-3d

# Пароль на изменение складов. Пусто — менять могут все, кто открыл приложение
#EDIT_PASSWORD=

# Учётная система (1С, ERP, WMS): запросы приложения к адресу erp/… сервер передаст сюда
#ERP_URL=http://1c.zavod.local/base/hs/stock
#ERP_USER=
#ERP_PASSWORD=
#ERP_HEADERS={"Authorization":"Bearer …"}
# Сколько секунд один ответ учётной системы отдаётся всем пользователям (бережёт учётную систему)
#ERP_CACHE_SEC=5

# Сколько резервных копий модели хранить
#BACKUPS=30
